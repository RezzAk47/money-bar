{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the one popup window may do. No file-system plugin, no shell plugin, no http plugin.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-fs-read",
    "allow-fs-stat",
    "allow-fs-write",
    "allow-fs-move-aside",
    "allow-set-tray-label",
    "allow-hide-popup",
    "allow-hold-popup-open",
    "allow-quit-app",
    "allow-fs-clean-temps",
    "allow-export-csv",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "opener:allow-reveal-item-in-dir"
  ]
}
